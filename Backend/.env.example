# ASNAD Backend Environment Template
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/asnad?retryWrites=true&w=majority

# Security & Sessions
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_for_aes_256_gcm

# Google OAuth & Drive API
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/google-drive/callback

# Google Picker & Cloud Project
GOOGLE_API_KEY=your_google_api_key
GOOGLE_PROJECT_NUMBER=your_google_project_number
